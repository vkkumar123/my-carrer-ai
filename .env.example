# Used by docker-compose.yml. Copy to .env (never put real keys in this file).
ANTHROPIC_API_KEY=
# Interviewer voice: Sarvam (Indian voices; Hindi, English, Hinglish). https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Optional fallback voice provider (English only): set VOICE_PROVIDER=deepgram to use it.
DEEPGRAM_API_KEY=
# VOICE_PROVIDER=sarvam

# Optional: Google sign-in via Supabase (see docs/GOOGLE_SIGN_IN.md)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: change host ports if they're already in use on your machine.
# WEB_HOST_PORT=3000
# API_HOST_PORT=8010
# POSTGRES_HOST_PORT=5433
