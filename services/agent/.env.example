# Copy to .env for local development.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Must match the API's LIVEKIT_AGENT_NAME: the API dispatches this agent into each round.
LIVEKIT_AGENT_NAME=mycareer-interviewer

API_BASE_URL=http://localhost:8000
INTERNAL_API_KEY=dev-internal-key

ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5

DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
INTERVIEWER_NAME=Alex
