# Copy to .env for local development.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://mycareer:mycareer@localhost:5432/mycareer
CORS_ORIGINS=http://localhost:3000

# dev = passwordless /auth/dev-login. In staging/prod: AUTH_MODE=supabase and
# JWT_SECRET = Supabase project JWT secret (Settings -> API).
AUTH_MODE=dev
JWT_SECRET=dev-only-jwt-secret-change-me-in-prod-0123456789

# Shared with the voice agent. Use a long random value outside local dev.
INTERNAL_API_KEY=dev-internal-key

ANTHROPIC_API_KEY=
LLM_MODEL_SMART=claude-opus-5
LLM_MODEL_FAST=claude-haiku-4-5

# Local LiveKit dev server defaults (livekit-server --dev)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=mycareer-interviewer

# local | s3 (Cloudflare R2, Supabase Storage or AWS S3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
