NEXT_PUBLIC_API_URL=http://localhost:8000

# Google sign-in via Supabase (see docs/GOOGLE_SIGN_IN.md). Leave empty to use only the
# development login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to false in staging/production to hide the development login.
NEXT_PUBLIC_DEV_LOGIN=true
# Optional: serve the browser runtimes (editor, SQL, Python, face detection) from object
# storage instead of this site's /vendor folder, e.g. https://assets.example.com/vendor
NEXT_PUBLIC_VENDOR_BASE_URL=
